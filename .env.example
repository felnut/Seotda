# Next.js 앱(Vercel)에서 접속할 소켓 서버 주소
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# 소켓 서버(Render 등)가 CORS를 허용할 프론트엔드 주소
CLIENT_URL=http://localhost:3000

# 멀티플레이어 AI 봇의 베팅 판단에 쓰는 Gemini API 키(무료 티어).
# https://aistudio.google.com/apikey 에서 발급. 없으면 ai.ts의 규칙 기반
# 로직으로 자동 대체된다.
GEMINI_API_KEY=
# 기본값은 gemini-2.5-flash. 필요할 때만 다른 모델로 덮어쓴다.
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase 클라이언트(Vercel) ---
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 웹 앱에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Identity Services(로그인 버튼)용 OAuth 웹 클라이언트 ID
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 확인
# (Firebase에서 Google 로그인을 활성화하면 자동으로 하나 생성됨)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 구글 애드센스. https://www.google.com/adsense 에서 사이트를 등록하면
# 발급되는 게시자 ID(ca-pub-로 시작)와, 화면별로 만든 광고 단위의 슬롯
# ID(숫자만). 클라이언트 ID가 없으면 애드센스 스크립트 자체가 로드되지
# 않고, 슬롯 ID가 없는 광고 영역은 그 자리만 렌더링되지 않는다.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
# 로비 화면 좌우의 세로형(160x600) 배너 — 같은 단위를 양쪽에 재사용한다.
NEXT_PUBLIC_ADSENSE_LOBBY_SIDE_SLOT_ID=
# 방 찾기 화면의 사각형(300x250) 배너
NEXT_PUBLIC_ADSENSE_ROOMS_RECT_SLOT_ID=

# 카카오톡 공유하기 버튼용 JavaScript 키.
# https://developers.kakao.com 에서 앱 생성 후 [내 애플리케이션] > [앱 키] >
# JavaScript 키를 발급받고, [플랫폼] > Web에 실제 배포 도메인
# (예: https://seotda.felnut.com)을 등록해야 동작한다. 비워두면 카카오톡
# 공유 버튼 자체가 화면에 나타나지 않는다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- Firebase 어드민(소켓 서버 / Render) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 발급
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 개행은 \n 리터럴로 저장 (코드에서 \n으로 치환해서 사용)
FIREBASE_PRIVATE_KEY=
