# Next.js 앱(Vercel)에서 접속할 소켓 서버 주소
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# 소켓 서버(Render 등)가 CORS를 허용할 프론트엔드 주소
CLIENT_URL=http://localhost:3000

# --- Firebase 클라이언트(Vercel) ---
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 웹 앱에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Identity Services(로그인 버튼)용 OAuth 웹 클라이언트 ID
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 확인
# (Firebase에서 Google 로그인을 활성화하면 자동으로 하나 생성됨)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Firebase 어드민(소켓 서버 / Render) ---
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성으로 발급
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 개행은 \n 리터럴로 저장 (코드에서 \n으로 치환해서 사용)
FIREBASE_PRIVATE_KEY=
